# ============================================
# CONFIGURACIÓN DE VARIABLES DE ENTORNO
# Tornilleria Jehova Jireh
# ============================================

# Base de datos PostgreSQL (Supabase, Neon, etc.)
# DESARROLLO: Usa sslmode=no-verify para evitar errores de certificado
# PRODUCCIÓN: Usa sslmode=verify-full para máxima seguridad
# Formato: postgresql://usuario:password@host:puerto/base_de_datos?sslmode=...
DATABASE_URL="postgresql://usuario:password@host:puerto/base_de_datos?sslmode=no-verify"

# URL del sitio (para SEO y sitemap)
# DESARROLLO: http://localhost:3000
# PRODUCCIÓN: https://tu-dominio.com
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Better Auth Configuration
# DESARROLLO: http://localhost:3000
# PRODUCCIÓN: https://tu-dominio.com (con HTTPS obligatorio)
BETTER_AUTH_URL="http://localhost:3000"

# Entorno (development/production)
NODE_ENV="development"

# Para despliegue en Vercel (opcional)
# VERCEL_URL="tu-app.vercel.app"

# Para despliegue en V0 (opcional)
# V0_RUNTIME_URL=""
# V0_DEV_APP_URL=""
# V0_BUILD_URL=""
# V0_SANDBOX_URL=""

# Email (Resend - para notificaciones de pedidos)
# Obtén tu API key en https://resend.com/api-keys
RESEND_API_KEY="re_your_api_key_here"
EMAIL_FROM="noreply@tu-dominio.com"
EMAIL_TO_ADMIN="admin@tu-dominio.com"

# Google Analytics
# Obtén tu Measurement ID en https://analytics.google.com
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# Chat en vivo (opcional)
# Habilita el chat de soporte en el sitio
NEXT_PUBLIC_CHAT_ENABLED="false"

# Verificación de Google Search Console (opcional)
# Obtén tu código de verificación en https://search.google.com/search-console
GOOGLE_SITE_VERIFICATION=""

# ============================================
# INSTRUCCIONES:
# 1. Copia este archivo a .env
# 2. Reemplaza los valores con tus datos reales
# 3. Para PRODUCCIÓN:
#    - Cambia sslmode=no-verify a sslmode=verify-full
#    - Cambia BETTER_AUTH_URL a tu dominio con https://
#    - Cambia NODE_ENV=production
#    - Configura RESEND_API_KEY para emails
#    - Configura NEXT_PUBLIC_GA_ID para analytics
# 4. Nunca commits el archivo .env al repositorio
# ============================================
